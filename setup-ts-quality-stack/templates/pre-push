#!/usr/bin/env sh
set -eu
# Runs the same gate as CI before pushing. Skip in an emergency: SKIP_PRE_PUSH=1 git push
# Adapt RUN to the repo's package manager (bun run / pnpm run / yarn run / npm run).
RUN="${RUN:-bun run}"

if [ "${SKIP_PRE_PUSH:-0}" = "1" ]; then
  exit 0
fi

echo "Running pre-push verification (check:fast)..."
# shellcheck disable=SC2086
exec $RUN check:fast
