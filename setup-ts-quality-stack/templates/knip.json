{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", "apps/web/components/ui/**", "apps/web/public/**"],
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["@swc/core", "oxlint-tsgolint"]
    },
    "apps/web": {},
    "apps/api": {
      "entry": ["src/main.ts"]
    },
    "packages/*": {
      "includeSubpathExports": true
    }
  }
}
