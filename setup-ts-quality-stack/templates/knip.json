{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".agents/**",
    "apps/web/components/ui/**",
    "apps/web/public/**",
    "supabase/**"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["@swc/core"]
    },
    "apps/web": {
      "entry": [
        "app/**/{page,layout,loading,error,not-found,global-error,template,default,route}.{ts,tsx}"
      ]
    },
    "packages/domain": {}
  }
}
