#!/usr/bin/env sh
set -eu
# Fast (<5s) pre-commit hook. Staged-content checks (forbidden files, lockfile coherence, token budget,
# formatting) live in scripts/staged-files.mjs, which reads the index with NUL-delimited paths.
# Adapt MIGRATIONS_DIR (or delete the migrations block if the repo has none).
set -f
IFS='
'
MIGRATIONS_DIR="supabase/migrations"

# Forward-only migrations guard: blocks modify/delete of migrations already on main/master.
# Override for intentional squashes: ALLOW_MIGRATION_EDIT=1 git commit ...
if [ "${ALLOW_MIGRATION_EDIT:-0}" != "1" ] && [ -d "$MIGRATIONS_DIR" ]; then
  BASE_REF=""
  for candidate in origin/main main origin/master master; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
      BASE_REF="$candidate"
      break
    fi
  done

  CHANGED_MIGRATIONS=$(git diff --cached --no-renames --name-only --diff-filter=MD -- "$MIGRATIONS_DIR/" || true)
  VIOLATING_MIGRATIONS=""

  if [ -n "$CHANGED_MIGRATIONS" ]; then
    if [ -n "$BASE_REF" ]; then
      CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
      if [ "$CURRENT_BRANCH" = "master" ] || [ "$CURRENT_BRANCH" = "main" ]; then
        VIOLATING_MIGRATIONS="$CHANGED_MIGRATIONS"
      else
        for f in $CHANGED_MIGRATIONS; do
          if git cat-file -e "${BASE_REF}:${f}" 2>/dev/null; then
            VIOLATING_MIGRATIONS="${VIOLATING_MIGRATIONS}${f}
"
          fi
        done
      fi
    else
      VIOLATING_MIGRATIONS="$CHANGED_MIGRATIONS"
    fi
  fi

  if [ -n "$(printf '%s' "$VIOLATING_MIGRATIONS" | tr -d '[:space:]')" ]; then
    echo "✗ Pre-commit blocked: migrations already on ${BASE_REF:-HEAD} are forward-only:" >&2
    printf '%s\n' "$VIOLATING_MIGRATIONS" | sed '/^$/d; s/^/  - /' >&2
    echo "  Create a new migration instead. For intentional squashes: ALLOW_MIGRATION_EDIT=1 git commit ..." >&2
    exit 1
  fi
fi

exec node scripts/staged-files.mjs
