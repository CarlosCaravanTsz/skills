{
  "name": "@org/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run --passWithNoTests .int.test.ts"
  },
  "dependencies": {
    "@org/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
