{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "vitest",
    "react",
    "jsx-a11y",
    "nextjs"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/next-env.d.ts",
    "**/.stryker-tmp/**",
    "apps/web/components/ui/**",
    "reports/**",
    ".agents/**",
    "scripts/**"
  ],
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": "error",
    "no-useless-catch": "error",
    "prefer-arrow-callback": "error",
    "no-console": "error",
    "no-underscore-dangle": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "unicorn/require-module-specifiers": "off",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-commented-out-tests": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-danger": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": "off"
  },
  "overrides": [
    {
      "files": [
        "packages/core/src/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "importNames": [
                  "Context",
                  "Layer",
                  "Clock",
                  "Random",
                  "ManagedRuntime",
                  "Console",
                  "Config",
                  "ConfigProvider",
                  "References"
                ],
                "message": "core is pure: no services, layers, config, clocks or randomness. Pass time and inputs explicitly."
              }
            ],
            "patterns": [
              {
                "group": [
                  "effect/*",
                  "!effect/Schema",
                  "!effect/Option",
                  "!effect/Result",
                  "!effect/Array",
                  "!effect/Order",
                  "!effect/Equal",
                  "!effect/Equivalence",
                  "!effect/Data",
                  "!effect/BigDecimal",
                  "!effect/Function",
                  "!effect/Predicate",
                  "!effect/Match",
                  "!effect/Brand",
                  "!effect/Struct",
                  "!effect/Record",
                  "!effect/Tuple"
                ],
                "message": "Only pure Effect modules in core (no IO, services or runtime modules)."
              },
              {
                "group": [
                  "node:*",
                  "node:*/**",
                  "bun",
                  "bun:*",
                  "@effect/**",
                  "@org/**"
                ],
                "message": "core must not depend on IO, the runtime, or other workspaces."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/**"
      ],
      "rules": {
        "no-console": [
          "error",
          {
            "allow": [
              "error",
              "warn"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/app/**/page.{ts,tsx}",
        "apps/web/app/**/layout.{ts,tsx}",
        "apps/web/app/**/loading.{ts,tsx}",
        "apps/web/app/**/error.{ts,tsx}",
        "apps/web/app/**/not-found.{ts,tsx}",
        "apps/web/app/**/global-error.{ts,tsx}",
        "apps/web/app/**/template.{ts,tsx}",
        "apps/web/app/**/default.{ts,tsx}",
        "apps/web/app/**/route.{ts,tsx}",
        "apps/web/proxy.ts",
        "**/*.config.{ts,tsx,js,mjs,cjs}"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
